# Copy this file to .env and fill in real values. .env is gitignored --
# never commit it. scripts/setup.sh will generate DJANGO_SECRET_KEY and
# randomize the placeholder passwords below automatically if you run it
# against a fresh .env.example.

# --- PostgreSQL / TimescaleDB (shared by Django) ---
POSTGRES_DB=weathernet
POSTGRES_USER=weathernet
POSTGRES_PASSWORD=changeme

# --- Read-only Postgres role used by Grafana's datasource ---
# Created by scripts/setup.sh after migrations run; grafana never uses
# the POSTGRES_USER credentials above.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=changeme

# --- Django ---
# Generated fresh by scripts/setup.sh -- do not ship a real default.
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=False
# Comma-separated. Must include the server's public IP.
DJANGO_ALLOWED_HOSTS=203.0.113.10

# --- TimescaleDB hypertable policies (see telemetry/migrations) ---
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_COMPRESS_AFTER_DAYS=7

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- WireGuard remote access (operator troubleshooting -- a separate
# channel from the mTLS telemetry path, see PROJECT_SPEC.md Section 5.7) ---
WIREGUARD_SUBNET=10.10.0.0/24
WIREGUARD_LISTEN_PORT=51820

# --- Used only by scripts/setup.sh and scripts/deploy.sh, not by any
# container directly ---
SERVER_PUBLIC_IP=203.0.113.10
