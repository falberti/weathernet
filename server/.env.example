# Copy this file to .env and fill in real values. .env is gitignored --
# never commit it. scripts/setup.sh will generate DJANGO_SECRET_KEY and
# randomize the placeholder passwords below automatically if you run it
# against a fresh .env.example.

# --- PostgreSQL / TimescaleDB (shared by Django) ---
POSTGRES_DB=weathernet
POSTGRES_USER=weathernet
POSTGRES_PASSWORD=changeme

# --- Read-only Postgres role used by Grafana's datasource ---
# Created by scripts/setup.sh after migrations run; grafana never uses
# the POSTGRES_USER credentials above.
GRAFANA_DB_USER=grafana_ro
GRAFANA_DB_PASSWORD=changeme

# --- Django ---
# Generated fresh by scripts/setup.sh -- do not ship a real default.
DJANGO_SECRET_KEY=changeme
DJANGO_DEBUG=False
# Comma-separated. Must include the server's public IP.
DJANGO_ALLOWED_HOSTS=203.0.113.10

# --- TimescaleDB hypertable policies (see telemetry/migrations) ---
TELEMETRY_RETENTION_DAYS=90
TELEMETRY_COMPRESS_AFTER_DAYS=7

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- WireGuard remote access (operator troubleshooting -- a separate
# channel from the mTLS telemetry path, see PROJECT_SPEC.md Section 5.8).
# Also read by Django (probes/wireguard.py) to allocate each newly
# enrolled probe's tunnel IP and to build the enroll response. ---
WIREGUARD_SUBNET=10.10.0.0/24
WIREGUARD_LISTEN_PORT=51820

# --- Zero-touch probe enrollment (PROJECT_SPEC.md Section 5.7) ---
# How long an EnrollmentToken stays redeemable after creation.
ENROLLMENT_TOKEN_TTL_MINUTES=30

# The VM's own SSH *public* key. Bind-mounted read-only into django and
# handed to every probe during enrollment, so the server can SSH into it
# with no manual key exchange -- see the top-level README. Change this if
# your login user or key type differs. Missing/unreadable is handled
# gracefully (enrollment still succeeds, just without this convenience).
SERVER_SSH_PUBLIC_KEY_HOST_PATH=/home/ubuntu/.ssh/id_ed25519.pub

# --- The server's own public IP. Used by scripts/setup.sh and
# scripts/deploy.sh, and also passed to Django to build the enroll
# response's server_url/server_endpoint and the ready-to-paste
# enrollment command admin.py prints. ---
SERVER_PUBLIC_IP=203.0.113.10
