# Rendered into nginx.conf by scripts/setup.sh, which substitutes
# ${SERVER_PUBLIC_IP}. nginx.conf itself is gitignored since it embeds
# the server's public IP.
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    # nginx has no built-in "just the CN" variable -- $ssl_client_s_dn
    # is the whole subject DN (e.g. "CN=<uuid>,O=WeatherNet"). Extract
    # the CN with a regex map so it works regardless of what other
    # fields are present or their order.
    map $ssl_client_s_dn $ssl_client_cn {
        default "";
        "~CN=(?<CN>[^,]+)" $CN;
    }

    server {
        listen 443 ssl;
        server_name ${SERVER_PUBLIC_IP};

        ssl_certificate     /etc/weathernet/pki/server.cert.pem;
        ssl_certificate_key /etc/weathernet/pki/server.key.pem;

        # mTLS: verify every client against the internal CA, enforced
        # below rather than by nginx's SSL layer itself. "optional_no_ca"
        # (not "optional") is required for that: plain "optional" still
        # hard-rejects the TLS handshake -- with nginx's own canned 400
        # response, before any location/if logic runs -- for any client
        # that presents a certificate failing verification. It only
        # tolerates a client presenting *no* certificate at all.
        # optional_no_ca defers that decision to us, via $ssl_client_verify
        # below, which is what lets /api/v1/ingest require a valid cert
        # while /api/v1/enroll and /admin/ (below) stay reachable
        # without one on the same port.
        ssl_client_certificate /etc/weathernet/pki/ca.cert.pem;
        ssl_verify_client optional_no_ca;
        ssl_verify_depth 1;

        client_max_body_size 64k;

        # Every reporting-cycle call a probe makes, once enrolled --
        # requires a valid client cert. Deliberately an exact match, not
        # a prefix: /api/v1/enroll (a brand-new probe has no cert yet)
        # must NOT be caught by this block, it needs the unauthenticated
        # location below instead.
        location = /api/v1/ingest {
            # Note: nginx's own "495"/"496" status codes are internal
            # pseudo-codes tied to its own SSL-required enforcement --
            # returning them explicitly here does not work as it looks
            # like it should (nginx silently substitutes its own canned
            # 400 response instead). Use ordinary status codes.
            if ($ssl_client_s_dn = "") {
                return 401;
            }
            if ($ssl_client_verify != SUCCESS) {
                return 403;
            }

            proxy_pass http://django:8000;
            # This is the header telemetry/views.py trusts as the
            # caller's identity -- it is only trustworthy because it is
            # set here, after successful client certificate
            # verification, and Django is unreachable except through
            # this proxy.
            proxy_set_header X-Client-Cert-CN $ssl_client_cn;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Everything else -- Django Admin and its static assets,
        # /api/v1/enroll (a brand-new probe has no client cert to
        # present yet; trust for that endpoint comes entirely from its
        # single-use token, checked by Django itself), and any unmapped
        # path -- is proxied straight through without an mTLS
        # requirement. Django's own authentication is the trust
        # boundary for /admin/, and Django's URLconf 404s on anything
        # it doesn't recognize.
        location / {
            proxy_pass http://django:8000;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Defense in depth: never forward a client-supplied value
            # for the header telemetry/views.py trusts as an identity,
            # even though this location can't reach that view.
            proxy_set_header X-Client-Cert-CN "";
        }
    }
}
