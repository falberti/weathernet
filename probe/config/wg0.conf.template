# Rendered by scripts/setup.sh into /etc/wireguard/wg0.conf. Point-to-
# point: this probe only ever talks to the server (AllowedIPs is the
# server's tunnel IP as a single /32), never to other probes.
[Interface]
PrivateKey = ${PROBE_WIREGUARD_PRIVATE_KEY}
Address = ${PROBE_TUNNEL_IP}/32

[Peer]
PublicKey = ${SERVER_WIREGUARD_PUBLIC_KEY}
Endpoint = ${SERVER_PUBLIC_IP}:${SERVER_WIREGUARD_PORT}
AllowedIPs = ${SERVER_TUNNEL_IP}/32
# Needed since the probe is almost certainly behind a home NAT with no
# port forwarding -- without a keepalive the NAT mapping times out and
# the server can't re-initiate the connection.
PersistentKeepalive = 25
