# config.php holds the API key and MySQL credentials, but as a .php
# file it's already safe by construction: any PHP hosting executes it
# rather than serving its source, so a direct request just gets a
# blank page, never the values (see config.php.example). This block is
# defense-in-depth, not the load-bearing protection -- it also covers
# any old .env this directory might still have from before that
# design, and the case where a leftover .bak/~ copy exists.
<FilesMatch "^(config\.php|\.env.*|.*\.bak|.*~)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.pem$">
    Require all denied
</FilesMatch>

# sync.php already refuses to run outside a CLI (cron) context on its
# own (see its PHP_SAPI check), but there's no reason to let a browser
# reach it at all -- belt and suspenders.
<Files "sync.php">
    Require all denied
</Files>
