# Copy to .env and fill in real values -- .env is blocked from direct
# URL access by .htaccess. Keep it out of version control too if you
# put this directory under git on the hosting side.

# The WeatherNet server's public IP (or hostname). Only sync.php uses
# this -- index.php reads MySQL only, it never talks to the VM.
VM_HOST=203.0.113.10
# Must match PUBLIC_SUMMARY_API_KEY in server/.env on the VM.
API_KEY=changeme

# MySQL, as created in your hosting control panel -- see schema.sql
# for the one table this needs (probe_cache).
DB_HOST=localhost
DB_NAME=changeme
DB_USER=changeme
DB_PASS=changeme
